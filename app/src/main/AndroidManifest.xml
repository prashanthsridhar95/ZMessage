<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Only for the optional "Fetch brand logos" setting (off by default); see LogoFetcher and ManifestPolicyTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for the optional morning digest (off by default): the notification, and putting its alarm back after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for the optional live alerts (off by default): hearing about a new code or bill the moment it arrives. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Only for the optional "Share codes with trusted people" (off by default, asked for only when it is switched on): sending
         a login code on by SMS to people the user chose. Google Play restricts SMS permissions, so this is for builds that are
         installed directly; see docs/ARCHITECTURE.md. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Only while a very large inbox is still being read month by month (BackfillService), and while a tracked flight is in the air or
         about to leave with live flight status switched on (FlightTrackingService): keeps that work going if the app is left. Both are
         data-sync services with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16 and later: lets the in-flight notification be a "Live Update" (progress on the lock screen and status bar). A normal permission, granted at install; ignored on older Android. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />


    <application
        android:name=".ZykeMessagesApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZykeMessage"
        tools:targetApi="31">
        <!-- The real launcher screen. It has no launcher entry of its own: the icon the person sees is one of the
             activity-aliases below (see AppIconChoice), exactly one of which is enabled at a time. Intents in this app
             name this class directly, which an alias does not get in the way of. -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZykeMessage" />

        <!-- Launcher icon colours: one alias per variant, only IconDefault enabled at first. Settings switches them with
             PackageManager (AppIconSwitcher); android cannot recolour an icon any other way. Keep in step with AppIconChoice. -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconRose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconPurple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono_round"
            android:label="@string/app_name"
            android:targetActivity=".presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Share logs" (ShareLogsActivity) and "Demo mode" (DemoActivity), whichever icon colour is enabled. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- The target of the "Share logs" launcher shortcut. No screen, no intent filter, not exported: the launcher
             starts static shortcuts through the system on the app's own behalf, and nothing else can reach it. It only
             opens the share sheet for the log files, so the person decides where they go. -->
        <activity
            android:name=".presentation.ShareLogsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/shortcut_share_logs"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The target of the "Demo mode" launcher shortcut. Like ShareLogsActivity: no screen, no intent filter, not exported,
             so nothing else can start it. It switches Demo mode on and restarts the app (see DemoSwitch). -->
        <activity
            android:name=".presentation.DemoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/shortcut_demo_mode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Starts the app again in a fresh process (Demo mode is entered and left that way). Its own process, so the one it
             replaces can end at once. No screen, no filter, not exported. -->
        <activity
            android:name=".presentation.RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Optional: reads incoming chat (RCS) messages from the messaging app's notifications, once the user allows it in system settings. -->
        <service
            android:name=".data.sms.RcsNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The "Add entry" quick-settings tile. Exported only because the system's quick-settings host must bind it;
             BIND_QUICK_SETTINGS_TILE lets nothing else do so. It only opens the entry sheet. -->
        <service
            android:name=".notifications.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_add_entry"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The scheduled backup: the system starts it when a backup is due and Wi-Fi/charging conditions hold.
             Not exported; only the system's job scheduler (BIND_JOB_SERVICE) can start it. -->
        <service
            android:name=".data.backup.BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Runs only while a large inbox is being read; stops by itself when every month has been read. -->
        <service
            android:name=".notifications.BackfillService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Runs only while live flight status and the flight notification are on and a flight is about to leave or in the air (at most two);
             refreshes its ongoing notification every 30 seconds and stops by itself on landing. Started by the app when it is in front, or
             by the alarm for the next flight where the phone allows it. Not exported. -->
        <service
            android:name=".notifications.FlightTrackingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- The train twin of the flight service above: runs only while live train status and the train notification are on and a journey is about to
             leave the person's station or under way (flights and trains together: at most two). Same type, same start rules. Not exported. -->
        <service
            android:name=".notifications.TrainTrackingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receivers: none is exported. The system delivers the widget, boot and alarm broadcasts to them. -->
        <receiver
            android:name=".notifications.DaysAheadWidget"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/days_ahead_widget_info" />
        </receiver>
        <receiver
            android:name=".notifications.QuickAddWidget"
            android:exported="false"
            android:label="@string/quick_add_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>
        <receiver
            android:name=".notifications.DigestReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.WeeklyReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.MarketCloseReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.CopyCodeReceiver"
            android:exported="false" />
        <!-- The alarm for the next tracked flight, ten minutes before it leaves. -->
        <receiver
            android:name=".notifications.FlightAlarmReceiver"
            android:exported="false" />
        <!-- The alarm for the next tracked train, ten minutes before it leaves the person's station. -->
        <receiver
            android:name=".notifications.TrainAlarmReceiver"
            android:exported="false" />
        <!-- Exported only because the phone's telephony service must reach it; the BROADCAST_SMS permission lets
             nothing else send to it. Disabled until the person turns on live alerts or code sharing. -->
        <receiver
            android:name=".notifications.SmsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- The phone's sent / delivered report on a code passed on to a trusted person. Only this app can reach it. -->
        <receiver
            android:name=".notifications.CodeShareStatusReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lets the user share the parsing report file. Not exported: access is granted per share only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>