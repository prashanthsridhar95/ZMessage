<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Only for the optional "Fetch brand logos" setting (off by default); see LogoFetcher and ManifestPolicyTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for the optional morning digest (off by default): the notification, and putting its alarm back after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for the optional live alerts (off by default): hearing about a new code or bill the moment it arrives. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Only while a very large inbox is still being read month by month: keeps that work going if the app is left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />


    <application
        android:name=".ZykeMessagesApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZykeMessage"
        tools:targetApi="31">
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZykeMessage">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional: reads incoming chat (RCS) messages from the messaging app's notifications, once the user allows it in system settings. -->
        <service
            android:name=".data.sms.RcsNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The "Add entry" quick-settings tile. Exported only because the system's quick-settings host must bind it;
             BIND_QUICK_SETTINGS_TILE lets nothing else do so. It only opens the entry sheet. -->
        <service
            android:name=".notifications.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_add_entry"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Runs only while a large inbox is being read; stops by itself when every month has been read. -->
        <service
            android:name=".notifications.BackfillService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receivers: none is exported. The system delivers the widget, boot and alarm broadcasts to them. -->
        <receiver
            android:name=".notifications.DaysAheadWidget"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/days_ahead_widget_info" />
        </receiver>
        <receiver
            android:name=".notifications.QuickAddWidget"
            android:exported="false"
            android:label="@string/quick_add_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>
        <receiver
            android:name=".notifications.DigestReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.WeeklyReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.CopyCodeReceiver"
            android:exported="false" />
        <!-- Exported only because the phone's telephony service must reach it; the BROADCAST_SMS permission lets
             nothing else send to it. Disabled until the person turns on live alerts. -->
        <receiver
            android:name=".notifications.SmsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lets the user share the parsing report file. Not exported: access is granted per share only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>