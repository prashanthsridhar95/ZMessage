<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same theme as values/themes.xml plus one thing that only exists from Android 10: MIUI, ColorOS and One UI can
         "force dark" third-party apps (Xiaomi: "Dark mode for third-party apps"), which inverts the app's own colours
         on top of its own Day and Night themes. The app draws both itself, so it opts out. -->
    <style name="Theme.ZykeMessage" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
