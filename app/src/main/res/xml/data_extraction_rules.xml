<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Cloud backup and phone-to-phone transfer take exactly one file: the encrypted snapshot this
     app keeps fresh itself when the person turns on "Back up to this phone's Android backup". Everything else
     (preferences, databases, other files, messages, caches, logs, the key store file) is left out. Cloud backup is
     skipped on a phone that cannot encrypt it. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="auto_backup/zyke-backup.bin" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="auto_backup/zyke-backup.bin" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
