<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- The code is what the notification is for, so it is the large text. The text styles are the system's own for
         notifications, so the colours follow the notification's background, light or dark, and are always readable. -->
    <TextView
        android:id="@+id/code_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:maxLines="1"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/code_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        style="@style/TextAppearance.Compat.Notification"
        android:textSize="13sp" />
</LinearLayout>
